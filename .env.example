# URL: Supabase → Data API → API URL
# Khoá: Project Settings → API Keys → Publishable key (sb_publishable_...) hoặc khoá anon (eyJ...)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# (Tuỳ chọn) Tên miền của email ảo phía sau tên đăng nhập. Chỉ đổi TRƯỚC khi có người dùng.
# VITE_EMAIL_DOMAIN=users.jomi.app
